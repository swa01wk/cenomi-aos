{
  "name": "aos-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/assert-no-dev-gallery.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../docs/specs/contracts/openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "openapi-fetch": "0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.51.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.25.10",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "5.0.5"
  }
}
