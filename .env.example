# Copy to .env (git-ignored). The Makefile loads it and passes it to Docker Compose.
# Plain KEY=value lines only: no quotes, no spaces around '='.

# Tests: superuser URL of the Compose Postgres (`make db`). With REQUIRE_PG=1, database tests fail instead of skipping.
AOS_TEST_ADMIN_URL=postgresql://aos_owner:aos_owner_dev@localhost:5432/postgres
AOS_TEST_REQUIRE_PG=1

# Kernel API for `make dev-api` (the Compose stack sets its own).
AOS_DATABASE_URL=postgresql://aos_kernel:aos_kernel_dev@localhost:5432/aos
AOS_SESSION_SECRET=aos-dev-session-secret-change-me-0123456789abcdef

# Model: only needed for real-model runs (the M1 exit gate, M4 evals). Every test uses the fake model.
# Skills ask for the alias `enterprise_reasoning`; this picks the provider and model behind it (docs/specs/agent/harness.md).
AOS_MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional second provider. Switch with AOS_MODEL_PROVIDER=anthropic (needs `pip install -e 'backend[anthropic]'`).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional per-alias override as provider:model, e.g. openai:gpt-5.4-mini. Empty = provider default above.
AOS_MODEL_ENTERPRISE_REASONING=
# Sampling temperature. Empty = the provider's default (some reasoning models reject any other value).
AOS_MODEL_TEMPERATURE=
# USD per million tokens, from the provider's price list, for ModelInvoked cost and the Seat's daily USD limit.
AOS_MODEL_PRICE_IN_PER_MTOK=
AOS_MODEL_PRICE_OUT_PER_MTOK=

# Demo controls (clock, vendor simulator, fault switches). Never on outside the POC.
AOS_DEMO=1

# When 1, deferred eval expectations block Seat approve/activate (M3 gate; default 0 in M1).
AOS_EVAL_STRICT=0

# SSE comment heartbeat interval in seconds for GET /instances/{id}/events and GET /events (default 15).
AOS_SSE_HEARTBEAT_SECONDS=15
